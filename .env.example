# Anthropic Claude API Key
# Obtén tu API key en: https://console.anthropic.com/
# Esta key es necesaria para la validación con IA en el Nivel 3
VITE_ANTHROPIC_API_KEY=your_api_key_here

# App Lock - Control de acceso a la aplicación
# Valores: "true" para bloquear la app, "false" o vacío para permitir acceso
# Útil para control de pagos o mantenimiento
VITE_APP_LOCKED=false
